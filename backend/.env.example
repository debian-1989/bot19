# ============================================
# CONFIGURACIÓN DEL BOT DE TRADING
# ============================================
# Copia este archivo a .env y completa los valores
# NUNCA commitees el archivo .env a git

# ============================================
# MODO DE TRADING (CRÍTICO)
# ============================================
# Contraseña local para cifrar la wallet generada por sesión.
# Nunca la subas a GitHub ni la compartas por chat.
BOT_WALLET_PASSWORD=
# El ejecutor live permanece deshabilitado hasta integrar y auditar swaps reales.
LIVE_EXECUTOR_ENABLED=false
# paper = Solo simulación, NO firma ni envía transacciones
# live = Trading real con dinero real (PELIGROSO)
TRADING_MODE=paper

# Habilitar trading real (debe ser false por defecto)
# Solo cambiar a true si:
# 1. Has probado exhaustivamente en paper mode
# 2. Tienes una wallet dedicada con fondos limitados
# 3. Entiendes los riesgos
ENABLE_LIVE_TRADING=false

# ============================================
# SOLANA RPC (OBLIGATORIO)
# ============================================
# RPC HTTP principal (Helius recomendado)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY_AQUI

# RPC WebSocket principal (para suscripciones en tiempo real)
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=TU_API_KEY_AQUI

# RPC HTTP de respaldo (opcional pero recomendado)
SOLANA_RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# RPC WebSocket de respaldo (opcional)
SOLANA_WS_FALLBACK_URL=wss://api.mainnet-beta.solana.com

# Niveles de confirmación
SOLANA_COMMITMENT_PROCESSED=processed
SOLANA_COMMITMENT_CONFIRM=confirmed
SOLANA_COMMITMENT_FINALIZED=finalized

# ============================================
# PROGRAMAS ON-CHAIN
# ============================================
# Programa oficial de Pump.fun
PUMP_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Programa de PumpSwap (si aplica)
# PUMPSWAP_PROGRAM_ID=

# Programa de Raydium
# RAYDIUM_PROGRAM_ID=

# ============================================
# WALLET (SOLO PARA BACKEND)
# ============================================
# Clave privada en formato base58
# NUNCA compartas esta clave
# NUNCA la commitees a git
# Usar solo una wallet dedicada con fondos limitados
WALLET_PRIVATE_KEY=

# Balance mínimo requerido para operar (en SOL)
MIN_WALLET_BALANCE=0.1

# ============================================
# LÍMITES DE RIESGO
# ============================================
# Límite diario máximo de pérdida (en SOL)
DAILY_LOSS_LIMIT=1.0

# Límite máximo por operación (en SOL)
MAX_TRADE_AMOUNT=0.5

# Slippage máximo permitido (%)
MAX_SLIPPAGE_PERCENT=15

# Slippage por defecto (%)
DEFAULT_SLIPPAGE_PERCENT=5

# Priority fee máximo (en micro-lamports)
MAX_PRIORITY_FEE=1000000

# Priority fee por defecto (en micro-lamports)
DEFAULT_PRIORITY_FEE=50000

# ============================================
# DETECCIÓN Y FILTROS
# ============================================
# Tamaño mínimo de compra a detectar (en SOL)
MIN_DETECTED_BUY_SIZE=0.01

# Tamaño máximo de compra a detectar (en SOL)
MAX_DETECTED_BUY_SIZE=5.0

# Liquidez mínima requerida (en SOL)
MIN_LIQUIDITY=0.5

# Capitalización máxima de mercado (en USD)
MAX_MARKET_CAP=50000

# ============================================
# ESTRATEGIA DE SALIDA
# ============================================
# Multiplicador de take profit (2x = 100% ganancia)
TAKE_PROFIT_MULTIPLIER=2.0

# Stop loss (%)
STOP_LOSS_PERCENT=30

# Trailing stop activation (%)
TRAILING_STOP_ACTIVATION=50

# Trailing stop distance (%)
TRAILING_STOP_PERCENT=15

# Tiempo máximo de posición (segundos)
TIME_BASED_EXIT=300

# Tiempo de salida por ganancia (segundos)
PROFIT_TIME_EXIT=180

# Pérdida máxima por trade (en SOL)
MAX_LOSS_PER_TRADE=0.05

# ============================================
# GESTIÓN DE POSICIONES
# ============================================
# Máximo de posiciones abiertas simultáneamente
MAX_CONCURRENT_TRADES=10

# Monto por operación (en SOL)
TRADE_AMOUNT=0.1

# ============================================
# BACKEND
# ============================================
# Puerto del servidor backend
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGS Y DEBUG
# ============================================
# Nivel de log: error, warn, info, debug
LOG_LEVEL=info

# Habilitar logs detallados
DEBUG=false

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. NUNCA commitees este archivo con valores reales
# 2. Usa .env.example como plantilla
# 3. La clave privada debe estar SOLO en .env
# 4. El modo live debe estar DESACTIVADO por defecto
# 5. Usa una wallet dedicada con fondos limitados
# 6. Prueba exhaustivamente en paper mode antes de live
# 7. Monitorea los logs constantemente
# 8. Configura límites de riesgo apropiados
# 9. Usa RPCs de calidad (Helius, QuickNode, etc.)
# 10. Ten un plan de contingencia para fallos
